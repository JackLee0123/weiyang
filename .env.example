# 后端数据库连接串。
# 开发/零配置：使用 SQLite（默认）
DATABASE_URL=sqlite:///./data/planner.db

# 生产/桌面客户端：连接随应用拉起的 MariaDB（MySQL 兼容）
# DATABASE_URL=mysql+pymysql://planner:planner@127.0.0.1:3307/planner_db?charset=utf8mb4

# 前端开发服务端口（后端 CORS 需要）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 邮件验证码（可选）。配置后注册时会真实发送验证码邮件；
# 不配置则走“开发模式”，发送接口会把验证码直接返回，方便本地联调。
# QQ 邮箱示例：SMTP_HOST=smtp.qq.com / SMTP_PORT=465 / SMTP_USE_SSL=true
# 163 邮箱示例：SMTP_HOST=smtp.163.com / SMTP_PORT=465 / SMTP_USE_SSL=true
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=未央 · Everlong
SMTP_USE_SSL=true
SMTP_STARTTLS=false
# 问题反馈收件邮箱，留空时使用上面的 SMTP_USER
FEEDBACK_TO_EMAIL=
VERIFY_CODE_TTL_SECONDS=600
VERIFY_CODE_COOLDOWN_SECONDS=60

# 登录访问令牌有效期（秒），默认 30 天
AUTH_TOKEN_TTL_SECONDS=2592000

# 超级管理员（用户管理）：启动时把该邮箱用户提升为管理员。
# 若该邮箱尚未注册，则用 SUPER_ADMIN_PASSWORD 创建管理员账号（仅作首次引导，请设强密码）。
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
