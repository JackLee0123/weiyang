<template>
  <div class="page {{light ? 'page-lt' : ''}}">
    <div class="topbar">
      <div class="back {{light ? 'back-lt' : ''}}" onclick="goBack">
        <text class="back-text {{light ? 'back-text-lt' : ''}}">‹</text>
      </div>
      <text class="title {{light ? 'title-lt' : ''}}">设置</text>
    </div>

    <div class="form">
      <div class="btn btn-primary" onclick="goConnect">
        <text class="btn-text">连接账户</text>
      </div>

      <div class="account">
        <text class="account-label {{light ? 'muted-lt' : ''}}">当前账号</text>
        <text class="account-value {{connected ? 'account-on' : ''}}">{{accountLabel}}</text>
      </div>

      <!-- 诊断：确认主题在存储里的原始值与最终取值 -->
      <div class="account">
        <text class="account-label {{light ? 'muted-lt' : ''}}">主题诊断</text>
        <text class="account-value {{light ? 'muted-lt' : ''}}">{{themeDebug}}</text>
      </div>

      <div class="btn btn-ghost {{light ? 'ghost-lt' : ''}}" onclick="testConnection">
        <text class="btn-text btn-text-accent {{light ? 'accent-lt' : ''}}">测试连接</text>
      </div>

      <div class="theme-row" onclick="toggleTheme">
        <text class="label theme-label {{light ? 'muted-lt' : ''}}">亮色模式</text>
        <div class="switch {{light ? 'switch-on' : ''}}">
          <div class="knob {{light ? 'knob-on' : ''}}"></div>
        </div>
      </div>

      <text if="{{msg}}" class="msg {{light ? 'warn-lt' : ''}}">{{msg}}</text>
    </div>

    <div class="help {{light ? 'help-lt' : ''}}">
      <text class="help-title {{light ? 'title-lt' : ''}}">如何连接</text>
      <text class="help-line {{light ? 'muted-lt' : ''}}">1. 点上方「连接账户」显示二维码</text>
      <text class="help-line {{light ? 'muted-lt' : ''}}">2. 手机端「设备连接」里扫码</text>
      <text class="help-line {{light ? 'muted-lt' : ''}}">3. 手机上点「连接」即可</text>
      <text class="help-line {{light ? 'muted-lt' : ''}}">手环经手机网络联网，需保持蓝牙连接</text>
    </div>
  </div>
</template>

<style>
  .page {
    flex-direction: column;
    width: 100%;
    height: 100%;
    padding: 28px 24px;
    background-color: #0b0f14;
  }
  .topbar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 28px;
  }
  .back {
    width: 56px;
    height: 56px;
    border-radius: 28px;
    background-color: #131a23;
    justify-content: center;
    align-items: center;
    margin-right: 20px;
  }
  .back-text {
    font-size: 40px;
    color: #94a3b8;
  }
  .title {
    font-size: 34px;
    font-weight: bold;
    color: #f1f5f9;
  }
  .form {
    flex-direction: column;
  }
  .label {
    font-size: 22px;
    color: #94a3b8;
    margin-bottom: 10px;
    margin-top: 18px;
  }
  .btn {
    width: 100%;
    height: 72px;
    border-radius: 36px;
    justify-content: center;
    align-items: center;
    margin-top: 24px;
  }
  .btn-primary {
    background-color: #0f766e;
  }
  .btn-ghost {
    background-color: #131a23;
    border: 2px solid #334155;
  }
  .btn-text {
    font-size: 26px;
    color: #f1f5f9;
  }
  .btn-text-accent {
    color: #5eead4;
  }
  .account {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 22px;
    padding: 0 4px;
  }
  .account-label {
    font-size: 22px;
    color: #94a3b8;
  }
  .account-value {
    font-size: 22px;
    color: #64748b;
  }
  .account-on {
    color: #5eead4;
  }
  .theme-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 28px;
  }
  .theme-label {
    margin-top: 0;
  }
  .switch {
    width: 84px;
    height: 44px;
    border-radius: 22px;
    background-color: #1e293b;
    padding: 4px;
  }
  .switch-on {
    background-color: #0f766e;
  }
  .knob {
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background-color: #64748b;
  }
  .knob-on {
    background-color: #5eead4;
    margin-left: 40px;
  }

  /* 亮色主题 */
  .page-lt { background-color: #f2f4f8; }
  .back-lt { background-color: #ffffff; }
  .back-text-lt { color: #475569; }
  .title-lt { color: #101828; }
  .muted-lt { color: #667085; }
  .accent-lt { color: #0f766e; }
  .ghost-lt { border-color: #d0d5dd; }
  .help-lt { background-color: #ffffff; border-color: #e3e8ef; }
  .warn-lt { color: #b45309; }
  .switch-on-lt { background-color: #0f766e; }
  .msg {
    font-size: 22px;
    color: #fbbf24;
    margin-top: 20px;
  }
  .help {
    flex-direction: column;
    margin-top: 40px;
    background-color: #131a23;
    border-radius: 20px;
    border: 2px solid #1e293b;
    padding: 24px;
  }
  .help-title {
    font-size: 24px;
    font-weight: bold;
    color: #e2e8f0;
    margin-bottom: 12px;
  }
  .help-line {
    font-size: 20px;
    color: #94a3b8;
    margin-top: 6px;
  }

  /* 手环（dp 宽度远小于手表）字号整体上调，否则实际显示明显偏小 */
  @media (max-width: 190) {
    .title { font-size: 46px; }
    .label { font-size: 30px; }
    .btn { height: 96px; border-radius: 48px; }
    .btn-text { font-size: 35px; }
    .account-label { font-size: 30px; }
    .account-value { font-size: 30px; }
    .msg { font-size: 30px; }
    .help-title { font-size: 32px; }
    .help-line { font-size: 27px; }
  }

  /* 胶囊屏（小米手环10，212x520）：更窄，字号再上调一档，按钮撑满宽度 */
  @media (shape: pill-shaped) {
    /* 胶囊屏两端是半径 104px 的大圆弧（见 SDK 皮肤配置），四周要留出安全区 */
    .page { padding: 104px 46px; padding-bottom: 104px; }
    .title { font-size: 50px; }
    .back { width: 64px; height: 64px; border-radius: 32px; }
    .back-text { font-size: 44px; }
    .label { font-size: 33px; }
    .btn { height: 108px; border-radius: 54px; margin-top: 26px; }
    .btn-text { font-size: 40px; }
    .account { margin-top: 26px; }
    .account-label { font-size: 33px; }
    .account-value { font-size: 33px; }
    .msg { font-size: 33px; }
    .help { margin-top: 28px; padding: 28px; }
    .help-title { font-size: 37px; }
    .help-line { font-size: 28px; }
    .theme-row { margin-top: 28px; }
    .switch { width: 100px; height: 54px; border-radius: 27px; }
    .knob { width: 44px; height: 44px; border-radius: 22px; }
    .knob-on { margin-left: 46px; }
  }
</style>

<script>
import router from '@system.router'
import { ready, getConfig, save, readTheme } from '../../common/scripts/store.js'
import { fetchMe } from '../../common/scripts/api.js'

export default {
  private: {
    light: false,
    themeDebug: '',
    connected: false,
    accountLabel: '未连接',
    msg: '',
  },

  onShow() {
    var self = this
    ready().then(function () {
      var cfg = getConfig()
      self.light = cfg.theme === 'light'
      self.connected = !!cfg.token
      self.accountLabel = cfg.token ? (cfg.accountName || '已连接') : '未连接'
      self.themeDebug = (cfg.theme || '(空)') + ' / 存储:'
    })
    readTheme().then(function (raw) {
      self.themeDebug = (getConfig().theme || '(空)') + ' / 存储:' + (raw === '' ? '(空)' : raw)
    })
  },

  toggleTheme() {
    var self = this
    this.light = !this.light
    save({ theme: this.light ? 'light' : 'dark' }).then(function () {
      self.msg = self.light ? '已切换到亮色模式' : '已切换到暗色模式'
      // 页面之间是各自独立的上下文，已经创建过的页面不会重新读取主题，
      // 所以切换后重建页面栈，保证每个页面都按新主题渲染。
      setTimeout(function () {
        router.clear()
        router.replace({ uri: '/pages/index' })
      }, 900)
    })
  },

  testConnection() {
    var self = this
    this.msg = '连接中…'
    if (!getConfig().token) {
      this.msg = '尚未连接账户，请先点「连接账户」扫码'
      return
    }
    fetchMe().then(function (user) {
      self.connected = true
      self.accountLabel = user.name || user.email || '已连接'
      self.msg = '连接成功：' + (user.name || user.email)
    }).catch(function (e) {
      self.msg = '连接失败：' + (e.message || e)
    })
  },

  goBack() {
    router.back()
  },

  goConnect() {
    router.push({ uri: '/pages/connect' })
  }
}
</script>
