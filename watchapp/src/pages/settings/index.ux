<template>
  <div class="page">
    <div class="topbar">
      <div class="back" onclick="goBack">
        <text class="back-text">‹</text>
      </div>
      <text class="title">设置</text>
    </div>

    <div class="form">
      <div class="btn btn-primary" onclick="goConnect">
        <text class="btn-text">连接账户</text>
      </div>

      <div class="account">
        <text class="account-label">当前账号</text>
        <text class="account-value {{connected ? 'account-on' : ''}}">{{accountLabel}}</text>
      </div>

      <div class="btn btn-ghost" onclick="testConnection">
        <text class="btn-text btn-text-accent">测试连接</text>
      </div>

      <div class="demo-row" onclick="toggleDemo">
        <text class="label demo-label">演示模式</text>
        <div class="switch {{demo ? 'switch-on' : ''}}">
          <div class="knob {{demo ? 'knob-on' : ''}}"></div>
        </div>
      </div>

      <text if="{{msg}}" class="msg">{{msg}}</text>
    </div>

    <div class="help">
      <text class="help-title">如何连接</text>
      <text class="help-line">1. 点上方「连接账户」显示二维码</text>
      <text class="help-line">2. 手机端「设备连接」里扫码</text>
      <text class="help-line">3. 手机上点「连接」即可</text>
      <text class="help-line">手环经手机网络联网，需保持蓝牙连接</text>
    </div>
  </div>
</template>

<style>
  .page {
    flex-direction: column;
    width: 100%;
    height: 100%;
    padding: 28px 24px;
    background-color: #0b0f14;
  }
  .topbar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 28px;
  }
  .back {
    width: 56px;
    height: 56px;
    border-radius: 28px;
    background-color: #131a23;
    justify-content: center;
    align-items: center;
    margin-right: 20px;
  }
  .back-text {
    font-size: 40px;
    color: #94a3b8;
  }
  .title {
    font-size: 34px;
    font-weight: bold;
    color: #f1f5f9;
  }
  .form {
    flex-direction: column;
  }
  .label {
    font-size: 22px;
    color: #94a3b8;
    margin-bottom: 10px;
    margin-top: 18px;
  }
  .btn {
    width: 100%;
    height: 72px;
    border-radius: 36px;
    justify-content: center;
    align-items: center;
    margin-top: 24px;
  }
  .btn-primary {
    background-color: #0f766e;
  }
  .btn-ghost {
    background-color: #131a23;
    border: 2px solid #334155;
  }
  .btn-text {
    font-size: 26px;
    color: #f1f5f9;
  }
  .btn-text-accent {
    color: #5eead4;
  }
  .account {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 22px;
    padding: 0 4px;
  }
  .account-label {
    font-size: 22px;
    color: #94a3b8;
  }
  .account-value {
    font-size: 22px;
    color: #64748b;
  }
  .account-on {
    color: #5eead4;
  }
  .demo-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 28px;
  }
  .demo-label {
    margin-top: 0;
  }
  .switch {
    width: 84px;
    height: 44px;
    border-radius: 22px;
    background-color: #1e293b;
    padding: 4px;
  }
  .switch-on {
    background-color: #0f766e;
  }
  .knob {
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background-color: #64748b;
  }
  .knob-on {
    background-color: #5eead4;
    margin-left: 40px;
  }
  .msg {
    font-size: 22px;
    color: #fbbf24;
    margin-top: 20px;
  }
  .help {
    flex-direction: column;
    margin-top: 40px;
    background-color: #131a23;
    border-radius: 20px;
    border: 2px solid #1e293b;
    padding: 24px;
  }
  .help-title {
    font-size: 24px;
    font-weight: bold;
    color: #e2e8f0;
    margin-bottom: 12px;
  }
  .help-line {
    font-size: 20px;
    color: #94a3b8;
    margin-top: 6px;
  }

  /* 手环（dp 宽度远小于手表）字号整体上调，否则实际显示明显偏小 */
  @media (max-width: 190) {
    .title { font-size: 46px; }
    .label { font-size: 30px; }
    .btn { height: 96px; border-radius: 48px; }
    .btn-text { font-size: 35px; }
    .account-label { font-size: 30px; }
    .account-value { font-size: 30px; }
    .msg { font-size: 30px; }
    .help-title { font-size: 32px; }
    .help-line { font-size: 27px; }
  }

  /* 胶囊屏（小米手环10，212x520）：更窄，字号再上调一档，按钮撑满宽度 */
  @media (shape: pill-shaped) {
    .page { padding: 34px 18px; }
    .title { font-size: 62px; }
    .back { width: 76px; height: 76px; border-radius: 38px; }
    .back-text { font-size: 54px; }
    .label { font-size: 42px; }
    .btn { height: 128px; border-radius: 64px; margin-top: 30px; }
    .btn-text { font-size: 48px; }
    .account { margin-top: 30px; }
    .account-label { font-size: 42px; }
    .account-value { font-size: 42px; }
    .msg { font-size: 42px; }
    .help { margin-top: 34px; padding: 32px; }
    .help-title { font-size: 44px; }
    .help-line { font-size: 33px; }
    .demo-row { margin-top: 34px; }
    .switch { width: 112px; height: 60px; border-radius: 30px; }
    .knob { width: 50px; height: 50px; border-radius: 25px; }
    .knob-on { margin-left: 52px; }
  }
</style>

<script>
import router from '@system.router'
import { ready, getConfig, save } from '../../common/scripts/store.js'
import { fetchMe } from '../../common/scripts/api.js'

export default {
  private: {
    demo: false,
    connected: false,
    accountLabel: '未连接',
    msg: '',
  },

  onShow() {
    var self = this
    ready().then(function () {
      var cfg = getConfig()
      self.demo = cfg.demo
      self.connected = !!cfg.token
      self.accountLabel = cfg.token ? (cfg.accountName || '已连接') : '未连接'
    })
  },

  toggleDemo() {
    var self = this
    this.demo = !this.demo
    save({ demo: this.demo }).then(function () {
      self.msg = self.demo ? '演示模式已开启' : '演示模式已关闭'
    })
  },

  testConnection() {
    var self = this
    this.msg = '连接中…'
    save({ demo: this.demo }).then(function () {
      if (self.demo) {
        self.msg = '演示模式：无需连接'
        return null
      }
      if (!getConfig().token) {
        self.msg = '尚未连接账户，请先点「连接账户」扫码'
        return null
      }
      return fetchMe().then(function (user) {
        self.connected = true
        self.accountLabel = user.name || user.email || '已连接'
        self.msg = '连接成功：' + (user.name || user.email)
      }).catch(function (e) {
        self.msg = '连接失败：' + (e.message || e)
      })
    })
  },

  goBack() {
    router.back()
  },

  goConnect() {
    save({ demo: this.demo }).then(function () {
      router.push({ uri: '/pages/connect' })
    })
  }
}
</script>
