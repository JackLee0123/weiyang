<template>
  <div class="page {{light ? 'page-lt' : ''}}">
    <div class="topbar">
      <div class="back {{light ? 'surface-lt' : ''}}" onclick="goBack">
        <text class="back-text {{light ? 'muted-lt' : ''}}">‹</text>
      </div>
      <div class="day-switch">
        <div class="switch-btn {{light ? 'surface-lt' : ''}}" onclick="prevDay">
          <text class="switch-text {{light ? 'muted-lt' : ''}}">‹</text>
        </div>
        <div class="day-title">
          <text class="day-name {{light ? 'strong-lt' : ''}}">周{{dayLabel}}</text>
          <text if="{{isToday && !capsule}}" class="today-badge {{light ? 'badge-lt' : ''}}">今天</text>
        </div>
        <div class="switch-btn {{light ? 'surface-lt' : ''}}" onclick="nextDay">
          <text class="switch-text {{light ? 'muted-lt' : ''}}">›</text>
        </div>
      </div>
      <div class="week-info" show="{{!capsule}}">
        <text class="week-text {{light ? 'faint-lt' : ''}}">{{weekLabel}}</text>
      </div>
    </div>

    <text if="{{termLine}}" class="term {{light ? 'faint-lt' : ''}}">{{termLine}}</text>

    <div if="{{!hasWeek1}}" class="notice {{light ? 'notice-lt' : ''}}">
      <text class="notice-text {{light ? 'warn-lt' : ''}}">后端未设置开学第 1 周日期，周次与过滤可能不准确</text>
    </div>

    <!-- 不用 list/list-item：改成普通容器循环，一行一门课，稳定得多 -->
    <div class="course-list">
      <div class="course-row" for="{{viewCourses}}">
        <text class="row-time {{light ? 'accent-lt' : ''}}">{{$item.timeText}}</text>
        <div class="row-main">
          <text class="row-name {{light ? 'strong-lt' : ''}} {{$item.isNow ? (light ? 'accent-lt' : 'row-now') : ($item.isPast ? 'row-past' : '')}}">{{$item.name}}</text>
          <text class="row-meta {{light ? 'muted-lt' : ''}}" show="{{$item.hasMeta}}">{{$item.metaText}}</text>
        </div>
      </div>
    </div>

    <div if="{{viewCourses.length === 0}}" class="empty">
      <text class="empty-text {{light ? 'faint-lt' : ''}}">这一天没有课</text>
      <text class="empty-hint {{light ? 'faint-lt' : ''}}">左右可切换其他天</text>
      <text if="{{courses.length > 0}}" class="empty-hint {{light ? 'faint-lt' : ''}}">本学期共 {{courses.length}} 门课程</text>
    </div>

    <div if="{{msg}}" class="msg-bar {{light ? 'notice-lt' : ''}}">
      <text class="msg-text {{light ? 'warn-lt' : ''}}">{{msg}}</text>
    </div>
  </div>
</template>

<style>
  .page {
    flex-direction: column;
    width: 100%;
    height: 100%;
    padding: 28px 24px;
    background-color: #0b0f14;
  }
  .topbar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
  }
  .back {
    width: 56px;
    height: 56px;
    border-radius: 28px;
    background-color: #131a23;
    justify-content: center;
    align-items: center;
  }
  .back-text {
    font-size: 40px;
    color: #94a3b8;
  }
  .day-switch {
    flex: 1;
    flex-direction: row;
    justify-content: center;
    align-items: center;
  }
  .switch-btn {
    width: 48px;
    height: 48px;
    border-radius: 24px;
    background-color: #131a23;
    justify-content: center;
    align-items: center;
    margin: 0 16px;
  }
  .switch-text {
    font-size: 32px;
    color: #94a3b8;
  }
  .day-title {
    flex-direction: row;
    align-items: center;
  }
  .day-name {
    font-size: 32px;
    font-weight: bold;
    color: #f1f5f9;
  }
  .today-badge {
    font-size: 18px;
    color: #5eead4;
    border: 2px solid #134e4a;
    border-radius: 12px;
    padding: 2px 10px;
    margin-left: 10px;
  }
  .week-info {
    width: 56px;
    align-items: flex-end;
  }
  .week-text {
    font-size: 18px;
    color: #64748b;
  }
  .term {
    font-size: 20px;
    color: #475569;
    margin-bottom: 12px;
  }
  .notice {
    background-color: #1c1917;
    border-radius: 14px;
    padding: 12px 18px;
    margin-bottom: 14px;
  }
  .notice-text {
    font-size: 18px;
    color: #fbbf24;
  }
  .empty {
    flex: 1;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
  .empty-text {
    font-size: 22px;
    color: #475569;
  }
  .empty-hint {
    font-size: 18px;
    color: #475569;
    margin-top: 10px;
  }
  .msg-bar {
    padding: 14px 20px;
    border-radius: 16px;
    background-color: #1c1917;
  }
  .msg-text {
    font-size: 20px;
    color: #fbbf24;
  }

  /* 课程按行显示：左边时间，右边课程名 + 地点 */
  .course-list {
    flex: 1;
    width: 100%;
    flex-direction: column;
  }
  .course-row {
    flex-direction: row;
    align-items: flex-start;
    padding: 16px 0;
  }
  .row-time {
    width: 170px;
    font-size: 24px;
    color: #5eead4;
  }
  .row-main {
    flex-direction: column;
    flex: 1;
  }
  .row-name {
    font-size: 26px;
    color: #f1f5f9;
  }
  .row-now {
    color: #5eead4;
  }
  .row-past {
    color: #64748b;
  }
  .row-meta {
    font-size: 20px;
    color: #94a3b8;
    margin-top: 6px;
  }

  /* 亮色主题：放在所有暗色规则之后才会生效 */
  .page-lt { background-color: #f2f4f8; }
  .surface-lt { background-color: #ffffff; }
  .strong-lt { color: #101828; }
  .muted-lt { color: #5a6472; }
  .faint-lt { color: #7d8797; }
  .accent-lt { color: #0f766e; }
  .badge-lt { color: #0f766e; border-color: #99f6e4; }
  .notice-lt { background-color: #fef3c7; }
  .warn-lt { color: #b45309; }

  /* 手环（dp 宽度远小于手表）字号整体上调，否则实际显示明显偏小 */
  @media (max-width: 190) {
    .switch-text { font-size: 42px; }
    .day-name { font-size: 42px; }
    .today-badge { font-size: 24px; }
    .week-text { font-size: 24px; }
    .term { font-size: 27px; }
    .notice-text { font-size: 24px; }
    .row-time { font-size: 27px; }
    .row-name { font-size: 35px; }
    .row-meta { font-size: 27px; }
    .empty-text { font-size: 29px; }
    .empty-hint { font-size: 24px; }
    .msg-text { font-size: 27px; }
  }

  /* 胶囊屏（小米手环10，212x520）：更窄，字号再上调一档，左右分栏改为更窄的时间列 */
  @media (shape: pill-shaped) {
    /* 胶囊屏两端是半径 104px 的大圆弧（见 SDK 皮肤配置），四周要留出安全区 */
    .page { padding: 104px 46px; padding-bottom: 104px; }
    .back { width: 56px; height: 56px; border-radius: 28px; }
    .back-text { font-size: 40px; }
    .switch-btn { width: 48px; height: 48px; border-radius: 24px; margin: 0 8px; }
    .switch-text { font-size: 40px; }
    .day-name { font-size: 40px; }
    .today-badge { font-size: 24px; padding: 3px 10px; }
    .week-info { width: 62px; }
    .week-text { font-size: 24px; }
    .term { font-size: 28px; }
    .notice-text { font-size: 25px; }
    .course-row { padding: 14px 0; }
    .row-time { width: 120px; font-size: 26px; }
    .row-name { font-size: 33px; }
    .row-meta { font-size: 26px; }
    .empty-text { font-size: 30px; }
    .empty-hint { font-size: 25px; }
    .msg-bar { padding: 12px 16px; }
    .msg-text { font-size: 27px; }
  }
</style>

<script>
import router from '@system.router'
import { ready, getConfig, isLight } from '../../common/scripts/store.js'
import { fetchCourses } from '../../common/scripts/api.js'
import { initDeviceInfo, isCapsule } from '../../common/scripts/device.js'
import {
  DAY_LABELS, mondayOf, weekdayOf, weekIndexFor,
  courseActiveOn, decorateCourse, nowMinutes
} from '../../common/scripts/timetable.js'

export default {
  private: {
    day: 1,
    isToday: true,
    dayLabel: '一',
    weekLabel: '',
    termLabel: '',
    termLine: '',
    capsule: false,
    hasWeek1: true,
    courses: [],
    periodTimes: [],
    weekIndex: 0,
    viewCourses: [],
    msg: '',
    light: false
  },

  onShow() {
    var today = new Date()
    this.day = weekdayOf(today)
    this.isToday = true
    this.dayLabel = DAY_LABELS[this.day - 1]
    var self = this
    initDeviceInfo().then(function () {
      self.capsule = isCapsule()
      self.updateTermLine()
    })
    this.load()
  },

  load() {
    var self = this
    this.msg = ''
    ready().then(function () {
      self.light = isLight()
      if (!getConfig().token) {
        self.msg = '请先在设置里连接账户'
        return null
      }
      return fetchCourses().then(function (data) {
        self.applyData(data)
      }).catch(function (e) {
        self.msg = e.message || '加载失败'
      })
    })
  },

  applyData(data) {
    var settings = (data && data.settings) || {}
    this.courses = (data && data.courses) || []
    this.periodTimes = settings.period_times || []
    this.termLabel = settings.active_term || ''
    this.hasWeek1 = !!settings.week1_date
    this.weekIndex = weekIndexFor(mondayOf(new Date()), settings.week1_date)
    this.weekLabel = this.weekIndex > 0 ? '第' + this.weekIndex + '周' : ''
    this.updateTermLine()
    this.renderDay()
  },

  // 胶囊屏顶栏放不下单独的周次列，把周次并到学期这一行
  updateTermLine() {
    if (this.capsule && this.weekLabel) {
      this.termLine = this.weekLabel + ' · ' + this.termLabel
    } else {
      this.termLine = this.termLabel
    }
  },

  renderDay() {
    var self = this
    var todayDay = weekdayOf(new Date())
    var nowMin = nowMinutes()
    this.isToday = this.day === todayDay
    this.dayLabel = DAY_LABELS[this.day - 1]
    this.viewCourses = this.courses
      .filter(function (c) {
        return c.day_of_week === self.day && courseActiveOn(c, self.weekIndex)
      })
      .sort(function (a, b) { return (a.start_period || 0) - (b.start_period || 0) })
      .map(function (c) {
        return decorateCourse(c, self.weekIndex, self.periodTimes, self.day, todayDay, nowMin)
      })
  },

  prevDay() {
    this.day = this.day === 1 ? 7 : this.day - 1
    this.renderDay()
  },

  nextDay() {
    this.day = this.day === 7 ? 1 : this.day + 1
    this.renderDay()
  },

  goBack() {
    router.back()
  }
}
</script>
