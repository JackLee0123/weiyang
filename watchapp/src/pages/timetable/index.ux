<template>
  <div class="page">
    <div class="topbar">
      <div class="back" onclick="goBack">
        <text class="back-text">‹</text>
      </div>
      <div class="day-switch">
        <div class="switch-btn" onclick="prevDay">
          <text class="switch-text">‹</text>
        </div>
        <div class="day-title">
          <text class="day-name">周{{dayLabel}}</text>
          <text if="{{isToday}}" class="today-badge">今天</text>
        </div>
        <div class="switch-btn" onclick="nextDay">
          <text class="switch-text">›</text>
        </div>
      </div>
      <div class="week-info">
        <text class="week-text">{{weekLabel}}</text>
      </div>
    </div>

    <text if="{{termLabel}}" class="term">{{termLabel}}</text>

    <div if="{{!hasWeek1}}" class="notice">
      <text class="notice-text">后端未设置开学第 1 周日期，周次与过滤可能不准确</text>
    </div>

    <list class="course-list">
      <list-item for="{{viewCourses}}" class="course-item">
        <div class="course-card {{$item.isNow ? 'course-now' : ($item.isPast ? 'course-past' : '')}}">
          <div class="course-time-col">
            <text class="course-time">{{$item.timeRange}}</text>
            <text class="course-period">{{$item.periods}}</text>
            <text if="{{$item.isNow}}" class="now-badge">进行中</text>
          </div>
          <div class="course-main">
            <text class="course-name">{{$item.name}}</text>
            <text if="{{$item.location}}" class="course-meta">{{$item.location}}</text>
            <text if="{{$item.teacher}}" class="course-meta">{{$item.teacher}} 老师</text>
            <text class="course-weeks">{{$item.weeksLabel}}</text>
          </div>
        </div>
      </list-item>
    </list>

    <div if="{{viewCourses.length === 0}}" class="empty">
      <text class="empty-text">这一天没有课</text>
    </div>

    <div if="{{msg}}" class="msg-bar">
      <text class="msg-text">{{msg}}</text>
    </div>
  </div>
</template>

