  }

  /* 手环（dp 宽度远小于手表）字号整体上调，否则实际显示明显偏小 */
  @media (max-width: 190) {
    .switch-text { font-size: 42px; }
    .day-name { font-size: 42px; }
    .today-badge { font-size: 24px; }
    .week-text { font-size: 24px; }
    .term { font-size: 27px; }
    .notice-text { font-size: 24px; }
    .course-time { font-size: 27px; }
    .course-period { font-size: 24px; }
    .now-badge { font-size: 24px; }
    .course-name { font-size: 35px; }
    .course-meta { font-size: 27px; }
    .course-weeks { font-size: 24px; }
    .empty-text { font-size: 29px; }
    .msg-text { font-size: 27px; }
  }

  /* 胶囊屏（小米手环10，212x520）：更窄，字号再上调一档，左右分栏改为更窄的时间列 */
  @media (shape: pill-shaped) {
    .page { padding: 34px 18px; }
    .back { width: 76px; height: 76px; border-radius: 38px; }
    .back-text { font-size: 54px; }
    .switch-btn { width: 64px; height: 64px; border-radius: 32px; margin: 0 10px; }
    .switch-text { font-size: 54px; }
    .day-name { font-size: 54px; }
    .today-badge { font-size: 30px; padding: 4px 12px; }
    .week-info { width: 74px; }
    .week-text { font-size: 30px; }
    .term { font-size: 36px; }
    .notice-text { font-size: 32px; }
    .course-card { padding: 28px; }
    .course-time-col { width: 190px; }
    .course-time { font-size: 36px; }
    .course-period { font-size: 32px; }
    .now-badge { font-size: 32px; }
    .course-name { font-size: 45px; }
    .course-meta { font-size: 36px; }
    .course-weeks { font-size: 32px; }
    .empty-text { font-size: 38px; }
    .msg-text { font-size: 36px; }
  }
</style>

<script>
import router from '@system.router'
import { ready, getConfig } from '../../common/scripts/store.js'
import { fetchCourses } from '../../common/scripts/api.js'
import {
  DAY_LABELS, todayISO, mondayOf, weekdayOf, weekIndexFor,
  courseActiveOn, decorateCourse, nowMinutes
} from '../../common/scripts/timetable.js'
import { demoTimetable } from '../../common/scripts/demo.js'

export default {
  private: {
    day: 1,
    isToday: true,
    dayLabel: '一',
    weekLabel: '',
    termLabel: '',
    hasWeek1: true,
    courses: [],
    periodTimes: [],
    weekIndex: 0,
    viewCourses: [],
    msg: ''
  },

  onShow() {
    var today = new Date()
    this.day = weekdayOf(today)
    this.isToday = true
    this.dayLabel = DAY_LABELS[this.day - 1]
    this.load()
  },

  load() {
    var self = this
    this.msg = ''
    ready().then(function () {
      if (getConfig().demo) {
        self.applyData(demoTimetable())
        return null
      }
      if (!getConfig().token) {
        self.msg = '请先在设置里连接账户'
        return null
      }
      return fetchCourses().then(function (data) {
        self.applyData(data)
      }).catch(function (e) {
        self.msg = e.message || '加载失败'
      })
    })
  },

  applyData(data) {
    var settings = (data && data.settings) || {}
    this.courses = (data && data.courses) || []
    this.periodTimes = settings.period_times || []
    this.termLabel = settings.active_term || ''
    this.hasWeek1 = !!settings.week1_date
    this.weekIndex = weekIndexFor(mondayOf(new Date()), settings.week1_date)
    this.weekLabel = this.weekIndex > 0 ? '第' + this.weekIndex + '周' : ''
    this.renderDay()
  },

  renderDay() {
    var self = this
    var todayDay = weekdayOf(new Date())
    var nowMin = nowMinutes()
    this.isToday = this.day === todayDay
    this.dayLabel = DAY_LABELS[this.day - 1]
    this.viewCourses = this.courses
      .filter(function (c) {
        return c.day_of_week === self.day && courseActiveOn(c, self.weekIndex)
      })
      .sort(function (a, b) { return (a.start_period || 0) - (b.start_period || 0) })
      .map(function (c) {
        return decorateCourse(c, self.weekIndex, self.periodTimes, self.day, todayDay, nowMin)
      })
  },

  prevDay() {
    this.day = this.day === 1 ? 7 : this.day - 1
    this.renderDay()
  },

  nextDay() {
    this.day = this.day === 7 ? 1 : this.day + 1
    this.renderDay()
  },

  goBack() {
    router.back()
  }
}
</script>
