<template>
  <div class="page {{light ? 'page-lt' : ''}}">
    <div class="topbar">
      <div class="back {{light ? 'surface-lt' : ''}}" onclick="goBack">
        <text class="back-text {{light ? 'muted-lt' : ''}}">‹</text>
      </div>
      <text class="title {{light ? 'strong-lt' : ''}}">连接账户</text>
    </div>

    <div if="{{state === 'loading'}}" class="center">
      <text class="muted {{light ? 'muted-lt' : ''}}">正在生成二维码…</text>
    </div>

    <div if="{{state === 'waiting'}}" class="waiting">
      <div class="qr-wrap">
        <qrcode class="qr" value="{{qrValue}}"></qrcode>
      </div>
      <text class="code {{light ? 'accent-lt' : ''}}">{{code}}</text>
      <text class="hint {{light ? 'muted-lt' : ''}}">手机端「设备连接」里扫码</text>
      <text class="hint-dim {{light ? 'faint-lt' : ''}}">{{countdown}} 秒后失效</text>
      <div class="refresh {{light ? 'ghost-lt' : ''}}" onclick="start">
        <text class="refresh-text {{light ? 'muted-lt' : ''}}">重新生成</text>
      </div>
    </div>

    <div if="{{state === 'done'}}" class="center">
      <div class="done-mark {{light ? 'done-lt' : ''}}">
        <text class="done-mark-text {{light ? 'accent-lt' : ''}}">✓</text>
      </div>
      <text class="done-title {{light ? 'strong-lt' : ''}}">已连接</text>
      <text class="done-name {{light ? 'accent-lt' : ''}}">{{accountName}}</text>
      <div class="btn" onclick="goBack">
        <text class="btn-text">完成</text>
      </div>
    </div>

    <div if="{{state === 'error'}}" class="center">
      <text class="err {{light ? 'warn-lt' : ''}}">{{message}}</text>
      <text class="hint-dim {{light ? 'faint-lt' : ''}}">{{serverHint}}</text>
      <div class="btn" onclick="start">
        <text class="btn-text">重新生成</text>
      </div>
    </div>
  </div>
</template>

<style>
  .page {
    flex-direction: column;
    width: 100%;
    height: 100%;
    padding: 28px 24px;
    background-color: #0b0f14;
  }
  .topbar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 20px;
  }
  .back {
    width: 56px;
    height: 56px;
    border-radius: 28px;
    background-color: #131a23;
    justify-content: center;
    align-items: center;
    margin-right: 20px;
  }
  .back-text {
    font-size: 40px;
    color: #94a3b8;
  }
  .title {
    font-size: 34px;
    font-weight: bold;
    color: #f1f5f9;
  }
  .center {
    flex: 1;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
  .waiting {
    flex: 1;
    flex-direction: column;
    align-items: center;
  }
  /* 二维码要有足够对比度和面积，别人才扫得动。 */
  .qr-wrap {
    width: 320px;
    height: 320px;
    border-radius: 20px;
    background-color: #ffffff;
    padding: 14px;
    justify-content: center;
    align-items: center;
  }
  .qr {
    width: 292px;
    height: 292px;
  }
  .code {
    font-size: 38px;
    font-weight: bold;
    color: #5eead4;
    letter-spacing: 8px;
    margin-top: 20px;
  }
  .hint {
    font-size: 20px;
    color: #94a3b8;
    margin-top: 10px;
  }
  .hint-dim {
    font-size: 18px;
    color: #475569;
    margin-top: 6px;
  }
  .refresh {
    margin-top: 16px;
    padding: 10px 28px;
    border-radius: 24px;
    border: 2px solid #334155;
  }
  .refresh-text {
    font-size: 20px;
    color: #94a3b8;
  }
  .muted {
    font-size: 24px;
    color: #94a3b8;
  }
  .err {
    font-size: 24px;
    color: #fbbf24;
    text-align: center;
    margin-bottom: 8px;
  }
  .done-mark {
    width: 96px;
    height: 96px;
    border-radius: 48px;
    background-color: #134e4a;
    justify-content: center;
    align-items: center;
  }
  .done-mark-text {
    font-size: 52px;
    color: #5eead4;
  }
  .done-title {
    font-size: 32px;
    font-weight: bold;
    color: #f1f5f9;
    margin-top: 18px;
  }
  .done-name {
    font-size: 24px;
    color: #5eead4;
    margin-top: 8px;
  }
  .btn {
    width: 280px;
    height: 68px;
    border-radius: 34px;
    background-color: #0f766e;
    justify-content: center;
    align-items: center;
    margin-top: 30px;
  }
  .btn-text {
    font-size: 24px;
    color: #f1f5f9;
  }

  /* 亮色主题 */
  .page-lt { background-color: #f2f4f8; }
  .surface-lt { background-color: #ffffff; }
  .strong-lt { color: #101828; }
  .muted-lt { color: #5a6472; }
  .faint-lt { color: #7d8797; }
  .accent-lt { color: #0f766e; }
  .ghost-lt { border-color: #d0d5dd; }
  .done-lt { background-color: #ccfbf1; }
  .warn-lt { color: #b45309; }

  /* 手环（dp 宽度远小于手表）字号整体上调，否则实际显示会明显偏小 */
  @media (max-width: 190) {
    .title { font-size: 46px; }
    .muted { font-size: 32px; }
    .err { font-size: 32px; }
    .code { font-size: 50px; }
    .hint { font-size: 27px; }
    .hint-dim { font-size: 25px; }
    .refresh-text { font-size: 27px; }
    .done-title { font-size: 44px; }
    .done-name { font-size: 32px; }
    .btn { height: 92px; border-radius: 46px; }
    .btn-text { font-size: 32px; }
  }

  /* 胶囊屏（小米手环10，212x520）：屏幕更窄，二维码要占满宽度，字号再上调一档 */
  @media (shape: pill-shaped) {
    /* 胶囊屏两端是半径 104px 的大圆弧（见 SDK 皮肤配置），四周要留出安全区 */
    .page { padding: 104px 46px; padding-bottom: 104px; }
    .title { font-size: 50px; }
    .back { width: 64px; height: 64px; border-radius: 32px; }
    .back-text { font-size: 44px; }
    .qr-wrap { width: 360px; height: 360px; padding: 14px; }
    .qr { width: 332px; height: 332px; }
    .code { font-size: 52px; letter-spacing: 8px; }
    .muted { font-size: 34px; }
    .err { font-size: 34px; }
    .hint { font-size: 29px; }
    .hint-dim { font-size: 25px; }
    .refresh-text { font-size: 29px; }
    .done-mark { width: 116px; height: 116px; border-radius: 58px; }
    .done-mark-text { font-size: 60px; }
    .done-title { font-size: 48px; }
    .done-name { font-size: 34px; }
    .btn { width: 100%; height: 104px; border-radius: 52px; }
    .btn-text { font-size: 36px; }
  }
</style>

<script>
import router from '@system.router'
import brightness from '@system.brightness'
import { ready, getBaseUrl, save, readToken, isLight } from '../../common/scripts/store.js'
import { startHandshake, pollHandshake } from '../../common/scripts/api.js'

// 手环端二维码里放短载荷，模块越少越好扫；数字也会显示在二维码下方作为手输备用。
var QR_PREFIX = 'EVP:'
var DEVICE_LABEL = '小米手环'
var POLL_INTERVAL_MS = 3000
// 本地配置读取异常时的兜底等待时间：超时就先用默认配置开始连接。
var READY_TIMEOUT_MS = 3000

export default {
  private: {
    state: 'loading',
    code: '',
    qrValue: '',
    countdown: 0,
    accountName: '',
    message: '',
    serverHint: '',
    pollToken: '',
    expiredAt: 0,
    tickTimer: null,
    pollTimer: null,
    failures: 0,
    light: false,
    prevBrightness: null
  },

  onShow() {
    this.start()
  },

  onHide() {
    this.stopTimers()
    this.restoreBrightness()
  },

  onDestroy() {
    this.stopTimers()
    this.restoreBrightness()
  },

  start() {
    var self = this
    // 息屏再亮会重新走 onShow，此时若二维码还没过期就继续用，别让用户重扫一次。
    if (this.state === 'waiting' && this.pollToken && new Date().getTime() < this.expiredAt) {
      this.brighten()
      if (!this.tickTimer) this.startTimers()
      return
    }
    this.stopTimers()
    this.state = 'loading'
    this.message = ''
    this.serverHint = ''
    this.failures = 0

    var begun = false
    var begin = function () {
      if (begun || self.state !== 'loading') return
      begun = true
      self.beginHandshake()
    }
    setTimeout(begin, READY_TIMEOUT_MS)
    ready().then(function () {
      self.light = isLight()
      begin()
    })
  },

  beginHandshake() {
    var self = this
    startHandshake(DEVICE_LABEL).then(function (res) {
      self.code = res.code
      self.pollToken = res.poll_token
      self.qrValue = QR_PREFIX + res.code
      self.expiredAt = new Date().getTime() + res.expires_in * 1000
      self.countdown = res.expires_in
      self.state = 'waiting'
      self.brighten()
      self.startTimers()
    }).catch(function (e) {
      self.state = 'error'
      self.message = '生成失败：' + (e.message || e)
      self.serverHint = getBaseUrl().replace(/^https?:\/\//, '')
    })
  },

  startTimers() {
    var self = this
    this.tickTimer = setInterval(function () {
      var left = Math.round((self.expiredAt - new Date().getTime()) / 1000)
      self.countdown = left > 0 ? left : 0
      if (self.countdown <= 0 && self.state === 'waiting') {
        self.stopTimers()
        self.restoreBrightness()
        self.state = 'error'
        self.message = '二维码已失效，请重新生成'
      }
    }, 1000)

    this.pollTimer = setInterval(function () {
      self.checkApproved()
    }, POLL_INTERVAL_MS)
  },

  stopTimers() {
    if (this.tickTimer) {
      clearInterval(this.tickTimer)
      this.tickTimer = null
    }
    if (this.pollTimer) {
      clearInterval(this.pollTimer)
      this.pollTimer = null
    }
  },

  checkApproved() {
    var self = this
    if (this.state !== 'waiting') return
    pollHandshake(this.code, this.pollToken).then(function (res) {
      self.failures = 0
      if (res.status === 'approved' && res.token) {
        self.stopTimers()
        self.restoreBrightness()
        return save({ token: res.token, accountName: res.name || '' }).then(function () {
          // 写完立刻回读，确认真的落盘了再告诉用户成功。
          return readToken()
        }).then(function (saved) {
          if (saved !== res.token) {
            self.state = 'error'
            self.message = '登录信息没保存成功'
            self.serverHint = saved ? '存储内容与令牌不一致' : '存储回读为空'
            return
          }
          self.accountName = res.name || '你的账号'
          self.state = 'done'
        })
      }
      if (res.status === 'expired') {
        self.stopTimers()
        self.restoreBrightness()
        self.state = 'error'
        self.message = '二维码已失效，请重新生成'
      } else if (res.status === 'invalid') {
        self.stopTimers()
        self.restoreBrightness()
        self.state = 'error'
        self.message = '连接信息已失效，请重新生成'
      }
      // pending / claimed 继续等下一轮
    }).catch(function () {
      // 手环走蓝牙出网，偶发抖动很正常，连续失败多次才提示。
      self.failures += 1
      if (self.failures >= 5) {
        self.stopTimers()
        self.restoreBrightness()
        self.state = 'error'
        self.message = '网络不稳定，请检查手机连接后重试'
        self.serverHint = getBaseUrl().replace(/^https?:\/\//, '')
      }
    })
  },

  brighten() {
    var self = this
    try {
      brightness.getValue({
        success: function (data) {
          if (self.prevBrightness === null && data && typeof data.value === 'number') {
            self.prevBrightness = data.value
          }
          brightness.setValue({ value: 1 })
        },
        fail: function () {}
      })
    } catch (e) {
      // 设备不支持亮度调节时忽略，不影响连接流程。
    }
  },

  restoreBrightness() {
    if (this.prevBrightness === null) return
    var value = this.prevBrightness
    this.prevBrightness = null
    try {
      brightness.setValue({ value: value })
    } catch (e) {}
  },

  goBack() {
    router.back()
  }
}
</script>
