<template>
  <div class="page">
    <div class="topbar">
      <div class="back" onclick="goBack">
        <text class="back-text">‹</text>
      </div>
      <div class="tabs">
        <div class="tab {{tab === 'stats' ? 'tab-active' : ''}}" onclick="switchTab('stats')">
          <text class="tab-text {{tab === 'stats' ? 'tab-text-active' : ''}}">统计</text>
        </div>
        <div class="tab {{tab === 'timer' ? 'tab-active' : ''}}" onclick="switchTab('timer')">
          <text class="tab-text {{tab === 'timer' ? 'tab-text-active' : ''}}">计时</text>
        </div>
      </div>
      <text class="date-text">{{dateLabel}}</text>
    </div>

    <!-- 统计 -->
    <div if="{{tab === 'stats'}}" class="stats">
      <div class="summary">
        <div class="summary-block">
          <text class="summary-num">{{summary.count}}</text>
          <text class="summary-label">次专注</text>
        </div>
        <div class="divider"></div>
        <div class="summary-block">
          <text class="summary-num accent">{{totalLabel}}</text>
          <text class="summary-label">总计</text>
        </div>
      </div>

      <text if="{{slices.length === 0}}" class="empty">还没有专注记录</text>

      <!-- 同样不用 list/list-item，普通容器循环渲染更稳 -->
      <div class="slice-list" if="{{slices.length > 0}}">
        <div class="slice-row" for="{{slices}}">
          <div class="dot" style="background-color : {{$item.color}};"></div>
          <div class="slice-main">
            <text class="slice-label">{{$item.label}}</text>
            <div class="bar-bg">
              <div class="bar-fg" style="width : {{$item.percent}}%; background-color : {{$item.color}};"></div>
            </div>
          </div>
          <div class="slice-right">
            <text class="slice-minutes">{{$item.minutesLabel}}</text>
            <text class="slice-percent">{{$item.percent}}%</text>
          </div>
        </div>
      </div>
    </div>

    <!-- 计时 -->
    <div if="{{tab === 'timer'}}" class="timer">
      <div class="timer-circle">
        <text class="timer-time">{{clock}}</text>
        <text class="timer-state">{{running ? '专注中' : (elapsed > 0 ? '已暂停' : '就绪')}}</text>
      </div>

      <div class="timer-actions">
        <div class="btn btn-primary" onclick="toggleTimer">
          <text class="btn-text">{{running ? '暂停' : '开始'}}</text>
        </div>
        <div class="btn btn-ghost" if="{{elapsed > 0}}" onclick="finish">
          <text class="btn-text btn-text-accent">结束保存</text>
        </div>
        <div class="btn btn-ghost" if="{{elapsed > 0}}" onclick="discard">
          <text class="btn-text btn-text-danger">放弃</text>
        </div>
      </div>

      <text class="timer-hint">结束后写入「当日专注」记录</text>
    </div>

    <div if="{{msg}}" class="msg-bar">
      <text class="msg-text">{{msg}}</text>
    </div>
  </div>
</template>

<style>
  .page {
    flex-direction: column;
    width: 100%;
    height: 100%;
    padding: 28px 24px;
    background-color: #0b0f14;
  }
  .topbar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 24px;
  }
  .back {
    width: 56px;
    height: 56px;
    border-radius: 28px;
    background-color: #131a23;
    justify-content: center;
    align-items: center;
  }
  .back-text {
    font-size: 40px;
    color: #94a3b8;
  }
  .tabs {
    flex-direction: row;
    flex: 1;
    justify-content: center;
  }
  .tab {
    padding: 12px 30px;
    border-radius: 30px;
    margin: 0 8px;
    background-color: #131a23;
  }
  .tab-active {
    background-color: #134e4a;
  }
  .tab-text {
    font-size: 26px;
    color: #64748b;
  }
  .tab-text-active {
    color: #5eead4;
  }
  .date-text {
    width: 56px;
    font-size: 20px;
    color: #475569;
  }
  .stats {
    flex-direction: column;
    flex: 1;
  }
  .summary {
    flex-direction: row;
    background-color: #131a23;
    border-radius: 24px;
    border: 2px solid #1e293b;
    padding: 28px;
    margin-bottom: 24px;
    justify-content: space-around;
    align-items: center;
  }
  .summary-block {
    flex-direction: column;
    align-items: center;
  }
  .summary-num {
    font-size: 40px;
    font-weight: bold;
    color: #f1f5f9;
  }
  .accent {
    color: #5eead4;
  }
  .summary-label {
    font-size: 20px;
    color: #64748b;
    margin-top: 6px;
  }
  .divider {
    width: 2px;
    height: 60px;
    background-color: #1e293b;
  }
  .empty {
    font-size: 22px;
    color: #64748b;
    text-align: center;
    margin-top: 40px;
  }
  .slice-list {
    flex: 1;
    width: 100%;
  }
  .slice-row {
    flex-direction: row;
    align-items: center;
    background-color: #131a23;
    border-radius: 20px;
    border: 2px solid #1e293b;
    padding: 20px;
    margin-bottom: 16px;
    width: 100%;
  }
  .dot {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    margin-right: 16px;
  }
  .slice-main {
    flex-direction: column;
    flex: 1;
  }
  .slice-label {
    font-size: 24px;
    color: #e2e8f0;
  }
  .bar-bg {
    height: 8px;
    border-radius: 4px;
    background-color: #1e293b;
    margin-top: 10px;
  }
  .bar-fg {
    height: 8px;
    border-radius: 4px;
  }
  .slice-right {
    flex-direction: column;
    align-items: flex-end;
    margin-left: 16px;
  }
  .slice-minutes {
    font-size: 24px;
    color: #f1f5f9;
  }
  .slice-percent {
    font-size: 18px;
    color: #64748b;
    margin-top: 4px;
  }
  .timer {
    flex-direction: column;
    flex: 1;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 10px;
  }
  .timer-circle {
    width: 320px;
    height: 320px;
    border-radius: 160px;
    border: 6px solid #134e4a;
    justify-content: center;
    align-items: center;
    flex-direction: column;
  }
  .timer-time {
    font-size: 72px;
    font-weight: bold;
    color: #5eead4;
    font-family: sans-serif;
  }
  .timer-state {
    font-size: 22px;
    color: #64748b;
    margin-top: 10px;
  }
  .timer-actions {
    flex-direction: column;
    align-items: center;
  }
  .btn {
    width: 320px;
    height: 72px;
    border-radius: 36px;
    justify-content: center;
    align-items: center;
    margin-top: 16px;
  }
  .btn-primary {
    background-color: #0f766e;
  }
  .btn-ghost {
    background-color: #131a23;
    border: 2px solid #334155;
  }
  .btn-text {
    font-size: 26px;
    color: #f1f5f9;
  }
  .btn-text-accent {
    color: #5eead4;
  }
  .btn-text-danger {
    color: #f87171;
  }
  .timer-hint {
    font-size: 18px;
    color: #475569;
  }
  .msg-bar {
    margin-top: 16px;
    padding: 14px 20px;
    border-radius: 16px;
    background-color: #1c1917;
  }
  .msg-text {
    font-size: 20px;
    color: #fbbf24;
  }

  /* 手环（dp 宽度远小于手表）字号整体上调，否则实际显示明显偏小 */
  @media (max-width: 190) {
    .tab-text { font-size: 34px; }
    .date-text { font-size: 26px; }
    .summary-num { font-size: 54px; }
    .summary-label { font-size: 27px; }
    .empty { font-size: 29px; }
    .slice-label { font-size: 32px; }
    .slice-minutes { font-size: 32px; }
    .slice-percent { font-size: 24px; }
    .timer-circle { width: 380px; height: 380px; border-radius: 190px; }
    .timer-time { font-size: 94px; }
    .timer-state { font-size: 29px; }
    .timer-hint { font-size: 24px; }
    .btn { width: 380px; height: 94px; border-radius: 47px; }
    .btn-text { font-size: 34px; }
    .msg-text { font-size: 27px; }
  }

  /* 胶囊屏（小米手环10，212x520）：更窄，字号再上调一档，圆形计时器撑满宽度 */
  @media (shape: pill-shaped) {
    /* 胶囊屏两端是半径 104px 的大圆弧（见 SDK 皮肤配置），四周要留出安全区 */
    .page { padding: 104px 46px; padding-bottom: 104px; }
    .back { width: 64px; height: 64px; border-radius: 32px; }
    .back-text { font-size: 44px; }
    .tab { padding: 10px 18px; }
    .tab-text { font-size: 32px; }
    .date-text { width: 54px; font-size: 24px; }
    .summary { padding: 30px; }
    .summary-num { font-size: 60px; }
    .summary-label { font-size: 29px; }
    .empty { font-size: 30px; }
    .slice-label { font-size: 35px; }
    .slice-minutes { font-size: 35px; }
    .slice-percent { font-size: 26px; }
    .timer-circle { width: 360px; height: 360px; border-radius: 180px; }
    .timer-time { font-size: 96px; }
    .timer-state { font-size: 30px; }
    .timer-hint { font-size: 26px; }
    .btn { width: 100%; height: 104px; border-radius: 52px; }
    .btn-text { font-size: 36px; }
    .msg-text { font-size: 28px; }
  }
</style>

<script>
import router from '@system.router'
import { ready, getConfig } from '../../common/scripts/store.js'
import { fetchRecords, fetchPlans, createRecord } from '../../common/scripts/api.js'
import { summarizeFocus, formatMinutes, formatClock } from '../../common/scripts/focus.js'
import { todayISO } from '../../common/scripts/timetable.js'
import { demoRecords } from '../../common/scripts/demo.js'

export default {
  private: {
    tab: 'stats',
    dateLabel: '',
    summary: { count: 0, minutes: 0, slices: [] },
    totalLabel: '0分钟',
    slices: [],
    running: false,
    elapsed: 0,
    clock: '00:00',
    msg: '',
    timerId: null
  },

  onInit() {
    var d = new Date()
    this.dateLabel = (d.getMonth() + 1) + '月' + d.getDate() + '日'
  },

  onShow() {
    if (this.tab === 'stats') this.refreshStats()
  },

  onHide() {
    this.pauseTimer()
  },

  onDestroy() {
    this.pauseTimer()
  },

  switchTab(tab) {
    if (this.tab === tab) return
    if (tab === 'timer' && this.tab === 'timer') return
    if (tab === 'stats') {
      this.pauseTimer()
      this.refreshStats()
    }
    this.tab = tab
  },

  refreshStats() {
    var self = this
    this.msg = ''
    ready().then(function () {
      if (getConfig().demo) {
        self.applySummary(demoRecords())
        return null
      }
      if (!getConfig().token) {
        self.msg = '请先在设置里连接账户'
        return null
      }
      var today = todayISO()
      return Promise.all([fetchRecords(today, today), fetchPlans(today, today)]).then(function (r) {
        var titles = {}
        ;(r[1] || []).forEach(function (p) { titles[p.id] = p.title })
        self.applySummary(r[0] || [], titles)
      }).catch(function (e) {
        self.msg = e.message || '加载失败'
      })
    })
  },

  applySummary(records, titles) {
    this.summary = summarizeFocus(records, titles)
    this.totalLabel = formatMinutes(this.summary.minutes)
    this.slices = this.summary.slices.map(function (s) {
      s.minutesLabel = formatMinutes(s.minutes)
      return s
    })
  },

  toggleTimer() {
    if (this.running) {
      this.pauseTimer()
    } else {
      this.running = true
      var self = this
      this.timerId = setInterval(function () {
        self.elapsed += 1
        self.clock = formatClock(self.elapsed)
      }, 1000)
    }
  },

  pauseTimer() {
    if (this.timerId) {
      clearInterval(this.timerId)
      this.timerId = null
    }
    this.running = false
  },

  finish() {
    this.pauseTimer()
    var minutes = Math.max(1, Math.round(this.elapsed / 60) || 1)
    var self = this
    var payload = {
      date: todayISO(),
      title: '专注 · ' + minutes + ' 分钟',
      content: '手环专注',
      duration_minutes: minutes,
      is_completed: true,
      category: '其他',
      linked_plan_id: null
    }
    ready().then(function () {
      if (getConfig().demo) {
        self.afterSaved('演示模式：未真正保存')
        return null
      }
      return createRecord(payload).then(function () {
        self.afterSaved('已保存 ' + formatMinutes(minutes) + ' 专注')
      }).catch(function (e) {
        self.msg = '保存失败：' + (e.message || e)
        self.tab = 'stats'
      })
    })
  },

  afterSaved(message) {
    this.elapsed = 0
    this.clock = '00:00'
    this.tab = 'stats'
    this.refreshStats()
    this.msg = message
  },

  discard() {
    this.pauseTimer()
    this.elapsed = 0
    this.clock = '00:00'
  },

  goBack() {
    router.back()
  }
}
</script>
