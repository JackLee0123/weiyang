<template>
  <div class="page {{light ? 'page-lt' : ''}}">
    <div class="topbar">
      <div class="back {{light ? 'surface-lt' : ''}}" onclick="goBack">
        <text class="back-text {{light ? 'muted-lt' : ''}}">‹</text>
      </div>
      <div class="tabs">
        <div class="tab {{light ? 'surface-lt' : ''}} {{tab === 'stats' ? 'tab-active' : ''}} {{tab === 'stats' && light ? 'tab-active-lt' : ''}}" onclick="switchTab('stats')">
          <text class="tab-text {{light ? 'muted-lt' : ''}} {{tab === 'stats' ? 'tab-text-active' : ''}} {{tab === 'stats' && light ? 'accent-lt' : ''}}">统计</text>
        </div>
        <div class="tab {{light ? 'surface-lt' : ''}} {{tab === 'timer' ? 'tab-active' : ''}} {{tab === 'timer' && light ? 'tab-active-lt' : ''}}" onclick="switchTab('timer')">
          <text class="tab-text {{light ? 'muted-lt' : ''}} {{tab === 'timer' ? 'tab-text-active' : ''}} {{tab === 'timer' && light ? 'accent-lt' : ''}}">计时</text>
        </div>
      </div>
      <text class="date-text {{light ? 'faint-lt' : ''}}">{{capsule ? dateShort : dateLabel}}</text>
    </div>

    <!-- 统计 -->
    <div if="{{tab === 'stats'}}" class="stats">
      <div class="summary {{light ? 'card-lt' : ''}}">
        <div class="summary-block">
          <text class="summary-num {{light ? 'strong-lt' : ''}}">{{summary.count}}</text>
          <text class="summary-label {{light ? 'muted-lt' : ''}}">次专注</text>
        </div>
        <div class="divider {{light ? 'divider-lt' : ''}}"></div>
        <div class="summary-block">
          <text class="summary-num accent {{light ? 'accent-lt' : ''}}">{{totalLabel}}</text>
          <text class="summary-label {{light ? 'muted-lt' : ''}}">总计</text>
        </div>
      </div>

      <text if="{{slices.length === 0}}" class="empty {{light ? 'faint-lt' : ''}}">还没有专注记录</text>

      <!-- 同样不用 list/list-item，普通容器循环渲染更稳 -->
      <div class="slice-list" if="{{slices.length > 0}}">
        <div class="slice-row" for="{{slices}}">
          <div class="slice-head">
            <text class="slice-label {{light ? 'strong-lt' : ''}}">{{$item.label}}</text>
            <text class="slice-minutes {{light ? 'muted-lt' : ''}}">{{$item.minutesLabel}} · {{$item.percent}}%</text>
          </div>
          <div class="bar-bg {{light ? 'bar-lt' : ''}}">
            <div class="bar-fg" style="width : {{$item.percent}}%; background-color : {{$item.color}};"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- 计时 -->
    <div if="{{tab === 'timer'}}" class="timer">
      <div class="timer-circle {{light ? 'circle-lt' : ''}}">
        <text class="timer-time {{light ? 'accent-lt' : ''}}">{{clock}}</text>
        <text class="timer-state {{light ? 'muted-lt' : ''}}">{{running ? '专注中' : (elapsed > 0 ? '已暂停' : '就绪')}}</text>
      </div>

      <div class="timer-actions">
        <div class="btn btn-primary" onclick="toggleTimer">
          <text class="btn-text">{{running ? '暂停' : '开始'}}</text>
        </div>
        <div class="btn btn-ghost {{light ? 'ghost-lt' : ''}}" if="{{elapsed > 0}}" onclick="finish">
          <text class="btn-text btn-text-accent {{light ? 'accent-lt' : ''}}">结束保存</text>
        </div>
        <div class="btn btn-ghost {{light ? 'ghost-lt' : ''}}" if="{{elapsed > 0}}" onclick="discard">
          <text class="btn-text btn-text-danger">放弃</text>
        </div>
      </div>

      <text class="timer-hint {{light ? 'faint-lt' : ''}}">结束后写入「当日专注」记录</text>
    </div>

    <div if="{{msg}}" class="msg-bar">
      <text class="msg-text">{{msg}}</text>
    </div>
  </div>
</template>

<style>
  .page {
    flex-direction: column;
    width: 100%;
    height: 100%;
    padding: 28px 24px;
    background-color: #0b0f14;
  }
  .topbar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 24px;
  }
  .back {
    width: 56px;
    height: 56px;
    border-radius: 28px;
    background-color: #131a23;
    justify-content: center;
    align-items: center;
  }
  .back-text {
    font-size: 40px;
    color: #94a3b8;
  }
  .tabs {
    flex-direction: row;
    flex: 1;
    justify-content: center;
  }
  .tab {
    padding: 12px 30px;
    border-radius: 30px;
    margin: 0 8px;
    background-color: #131a23;
  }
  .tab-active {
    background-color: #134e4a;
  }
  .tab-text {
    font-size: 26px;
    color: #64748b;
  }
  .tab-text-active {
    color: #5eead4;
  }
  .date-text {
    width: 100px;
    font-size: 20px;
    color: #475569;
    text-align: right;
  }
  .stats {
    flex-direction: column;
    flex: 1;
  }
  .summary {
    flex-direction: row;
    background-color: #131a23;
    border-radius: 24px;
    border: 2px solid #1e293b;
    padding: 28px;
    margin-bottom: 24px;
    justify-content: space-around;
    align-items: center;
  }
  .summary-block {
    flex-direction: column;
    align-items: center;
  }
  .summary-num {
    font-size: 40px;
    font-weight: bold;
    color: #f1f5f9;
  }
  .accent {
    color: #5eead4;
  }
  .summary-label {
    font-size: 20px;
    color: #64748b;
    margin-top: 6px;
  }
  .divider {
    width: 2px;
    height: 60px;
    background-color: #1e293b;
  }
  .empty {
    font-size: 22px;
    color: #64748b;
    text-align: center;
    margin-top: 40px;
  }
  .slice-list {
    flex: 1;
    width: 100%;
    /* 不设方向时默认横向排列，会把每段专注挤成一排三个 */
    flex-direction: column;
  }
  .slice-row {
    flex-direction: column;
    margin-bottom: 22px;
    width: 100%;
  }
  /* 每段专注占一行：上面是名称与时长，下面是进度条 */
  .slice-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
  }
  .slice-label {
    font-size: 24px;
    color: #e2e8f0;
  }
  .bar-bg {
    height: 12px;
    border-radius: 6px;
    background-color: #1e293b;
  }
  .bar-fg {
    height: 12px;
    border-radius: 6px;
  }
  .slice-minutes {
    font-size: 22px;
    color: #94a3b8;
  }
  .timer {
    flex-direction: column;
    flex: 1;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 10px;
  }
  .timer-circle {
    width: 320px;
    height: 320px;
    border-radius: 160px;
    border: 6px solid #134e4a;
    justify-content: center;
    align-items: center;
    flex-direction: column;
  }
  .timer-time {
    font-size: 72px;
    font-weight: bold;
    color: #5eead4;
    font-family: sans-serif;
  }
  .timer-state {
    font-size: 22px;
    color: #64748b;
    margin-top: 10px;
  }
  .timer-actions {
    flex-direction: column;
    align-items: center;
  }
  .btn {
    width: 320px;
    height: 72px;
    border-radius: 36px;
    justify-content: center;
    align-items: center;
    margin-top: 16px;
  }
  .btn-primary {
    background-color: #0f766e;
  }
  .btn-ghost {
    background-color: #131a23;
    border: 2px solid #334155;
  }
  .btn-text {
    font-size: 26px;
    color: #f1f5f9;
  }
  .btn-text-accent {
    color: #5eead4;
  }
  .btn-text-danger {
    color: #f87171;
  }
  .timer-hint {
    font-size: 18px;
    color: #475569;
  }
  .msg-bar {
    margin-top: 16px;
    padding: 14px 20px;
    border-radius: 16px;
    background-color: #1c1917;
  }
  .msg-text {
    font-size: 20px;
    color: #fbbf24;
  }

  /* 亮色主题 */
  .page-lt { background-color: #f2f4f8; }
  .surface-lt { background-color: #ffffff; }
  .card-lt { background-color: #ffffff; border-color: #e3e8ef; }
  .title-lt { color: #101828; }
  .strong-lt { color: #101828; }
  .muted-lt { color: #667085; }
  .faint-lt { color: #98a2b3; }
  .accent-lt { color: #0f766e; }
  .ghost-lt { border-color: #d0d5dd; }
  .divider-lt { background-color: #e3e8ef; }
  .bar-lt { background-color: #eaecf0; }
  .circle-lt { border-color: #99f6e4; }
  .tab-active-lt { background-color: #ccfbf1; }
  .warn-lt { color: #b45309; }

  /* 手环（dp 宽度远小于手表）字号整体上调，否则实际显示明显偏小 */
  @media (max-width: 190) {
    /* 手环顶栏窄，标签内边距收一点，避免「统计/计时」被挤到显示不全 */
    .tab { padding: 10px 16px; }
    .tab-text { font-size: 34px; }
    .date-text { font-size: 26px; }
    .summary-num { font-size: 54px; }
    .summary-label { font-size: 27px; }
    .empty { font-size: 29px; }
    .slice-label { font-size: 32px; }
    .slice-minutes { font-size: 29px; }
    .timer-circle { width: 380px; height: 380px; border-radius: 190px; }
    .timer-time { font-size: 94px; }
    .timer-state { font-size: 29px; }
    .timer-hint { font-size: 24px; }
    .btn { width: 380px; height: 94px; border-radius: 47px; }
    .btn-text { font-size: 34px; }
    .msg-text { font-size: 27px; }
  }

  /* 胶囊屏（小米手环10，212x520）：更窄，字号再上调一档，圆形计时器撑满宽度 */
  @media (shape: pill-shaped) {
    /* 胶囊屏两端是半径 104px 的大圆弧（见 SDK 皮肤配置），四周要留出安全区 */
    .page { padding: 104px 46px; padding-bottom: 104px; }
    .back { width: 64px; height: 64px; border-radius: 32px; }
    .back-text { font-size: 44px; }
    .tab { padding: 10px 18px; }
    .tab-text { font-size: 32px; }
    .date-text { width: 64px; font-size: 24px; }
    .summary { padding: 30px; }
    .summary-num { font-size: 60px; }
    .summary-label { font-size: 29px; }
    .empty { font-size: 30px; }
    .slice-label { font-size: 31px; }
    .slice-minutes { font-size: 27px; }
    .timer-circle { width: 360px; height: 360px; border-radius: 180px; }
    .timer-time { font-size: 96px; }
    .timer-state { font-size: 30px; }
    .timer-hint { font-size: 26px; }
    /* 父容器原本按内容宽度收缩，导致按钮的 width:100% 只拿到很窄的宽度，被挤成小圆 */
    .timer-actions { width: 100%; }
    .btn { width: 100%; height: 104px; border-radius: 52px; }
    .btn-text { font-size: 36px; }
    .msg-text { font-size: 28px; }
  }
</style>

<script>
import router from '@system.router'
import { ready, getConfig, isLight } from '../../common/scripts/store.js'
import { fetchRecords, fetchPlans, createRecord } from '../../common/scripts/api.js'
import { summarizeFocus, formatMinutes, formatClock, nextFocusName } from '../../common/scripts/focus.js'
import { initDeviceInfo, isCapsule } from '../../common/scripts/device.js'
import { todayISO } from '../../common/scripts/timetable.js'

export default {
  private: {
    tab: 'stats',
    dateLabel: '',
    dateShort: '',
    capsule: false,
    summary: { count: 0, minutes: 0, slices: [] },
    totalLabel: '0分钟',
    slices: [],
    running: false,
    elapsed: 0,
    clock: '00:00',
    msg: '',
    timerId: null,
    light: false
  },

  onInit() {
    var d = new Date()
    this.dateLabel = (d.getMonth() + 1) + '月' + d.getDate() + '日'
    // 胶囊屏顶栏窄，用短日期避免折行
    this.dateShort = (d.getMonth() + 1) + '/' + d.getDate()
    var self = this
    initDeviceInfo().then(function () {
      self.capsule = isCapsule()
    })
  },

  onShow() {
    if (this.tab === 'stats') this.refreshStats()
  },

  onHide() {
    this.pauseTimer()
  },

  onDestroy() {
    this.pauseTimer()
  },

  switchTab(tab) {
    if (this.tab === tab) return
    if (tab === 'timer' && this.tab === 'timer') return
    if (tab === 'stats') {
      this.pauseTimer()
      this.refreshStats()
    }
    this.tab = tab
  },

  refreshStats() {
    var self = this
    this.msg = ''
    ready().then(function () {
      self.light = isLight()
      if (!getConfig().token) {
        self.msg = '请先在设置里连接账户'
        return null
      }
      var today = todayISO()
      return Promise.all([fetchRecords(today, today), fetchPlans(today, today)]).then(function (r) {
        var titles = {}
        ;(r[1] || []).forEach(function (p) { titles[p.id] = p.title })
        self.applySummary(r[0] || [], titles)
      }).catch(function (e) {
        self.msg = e.message || '加载失败'
      })
    })
  },

  applySummary(records, titles) {
    this.summary = summarizeFocus(records, titles)
    this.totalLabel = formatMinutes(this.summary.minutes)
    this.slices = this.summary.slices.map(function (s) {
      s.minutesLabel = formatMinutes(s.minutes)
      return s
    })
  },

  toggleTimer() {
    if (this.running) {
      this.pauseTimer()
    } else {
      this.running = true
      var self = this
      this.timerId = setInterval(function () {
        self.elapsed += 1
        self.clock = formatClock(self.elapsed)
      }, 1000)
    }
  },

  pauseTimer() {
    if (this.timerId) {
      clearInterval(this.timerId)
      this.timerId = null
    }
    this.running = false
  },

  finish() {
    this.pauseTimer()
    var minutes = Math.max(1, Math.round(this.elapsed / 60) || 1)
    var self = this
    var today = todayISO()
    var payload = {
      date: today,
      title: '',
      content: '手环专注 · ' + minutes + ' 分钟',
      duration_minutes: minutes,
      is_completed: true,
      category: '其他',
      linked_plan_id: null
    }
    ready().then(function () {
      self.light = isLight()
      // 默认名按当天已有专注段数顺延：a、b、c…… 名称在网页端/PWA 可以再改
      return fetchRecords(today, today).then(function (records) {
        payload.title = nextFocusName(records)
        return createRecord(payload)
      }).then(function () {
        self.afterSaved('已保存 ' + formatMinutes(minutes) + ' 专注')
      }).catch(function (e) {
        self.msg = '保存失败：' + (e.message || e)
        self.tab = 'stats'
      })
    })
  },

  afterSaved(message) {
    this.elapsed = 0
    this.clock = '00:00'
    this.tab = 'stats'
    this.refreshStats()
    this.msg = message
  },

  discard() {
    this.pauseTimer()
    this.elapsed = 0
    this.clock = '00:00'
  },

  goBack() {
    router.back()
  }
}
</script>
