{
  "name": "everlong",
  "version": "0.1.0",
  "private": true,
  "description": "未央 · Everlong — 本地任务计划客户端 MVP：提前排期 + 每日记录，React + FastAPI + MySQL/MariaDB",
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c blue,green \"pnpm dev:backend\" \"pnpm dev:frontend\"",
    "dev:backend": "cd backend && uv run uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload",
    "dev:frontend": "pnpm --filter frontend dev",
    "gen:api": "pnpm --filter frontend gen:api",
    "build": "pnpm build:frontend",
    "build:frontend": "pnpm --filter frontend build",
    "test": "pnpm test:backend && pnpm test:frontend",
    "test:backend": "cd backend && uv run pytest -q",
    "test:frontend": "pnpm --filter frontend test:run"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
